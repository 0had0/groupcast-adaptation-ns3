+void
+NrHarqPhy::AliasSlDataHarqProcess(uint16_t fromRnti, uint16_t toRnti, uint8_t harqId)
+{
+    NS_LOG_FUNCTION(this << fromRnti << toRnti << static_cast<uint16_t>(harqId));
+    auto fromIt = m_slHistory.find(fromRnti);
+    if (fromIt != m_slHistory.end()) {
+        auto fromProcIt = fromIt->second.find(harqId);
+        if (fromProcIt != fromIt->second.end()) {
+            auto toIt = m_slHistory.find(toRnti);
+            if (toIt == m_slHistory.end()) {
+                m_slHistory.insert(std::make_pair(toRnti, ProcIdHistoryMap()));
+                toIt = m_slHistory.find(toRnti);
+            }
+            toIt->second[harqId] = fromProcIt->second;
+        }
+    }
+    
+    uint32_t fromDecodedId = (fromRnti << 8) + harqId;
+    if (m_slDecodedTb.find(fromDecodedId) != m_slDecodedTb.end()) {
+        uint32_t toDecodedId = (toRnti << 8) + harqId;
+        m_slDecodedTb.insert(toDecodedId);
+    }
+}
 } // namespace ns3
