+void
+NrSlUeMacHarq::ForceHarqIdForRelay(uint8_t harqId, uint32_t dstL2Id, uint32_t maxNumTx, Ptr<PacketBurst> pb)
+{
+    NS_LOG_FUNCTION(this << +harqId << dstL2Id);
+    // Remove it from the available pool if it's there
+    for (auto it = m_idBuffer.begin(); it != m_idBuffer.end(); ++it) {
+        if (*it == harqId) {
+            m_idBuffer.erase(it);
+            break;
+        }
+    }
+    m_pktBuffer.at(harqId).allocated = true;
+    m_pktBuffer.at(harqId).dstL2Id = dstL2Id;
+    m_pktBuffer.at(harqId).multiplePdu = false;
+    m_pktBuffer.at(harqId).maxNumTx = maxNumTx;
+    m_pktBuffer.at(harqId).numTx = 1; // already transmitted once by leader
+    m_pktBuffer.at(harqId).pktBurst = pb;
+    m_pktBuffer.at(harqId).harqEnabled = false; // no feedback needed for relay
+}
