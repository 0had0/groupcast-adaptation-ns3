<?xml version="1.0" encoding="UTF-8"?>
<!--
  intersection_nlosv — edge definitions
  =======================================
  All edges: 1 lane, speed limit 50 km/h (13.89 m/s), priority 3.
  Dummy arms carry priority 1 so the main route always has right-of-way.

  Platoon route: e_approach → e_vertical → e_exit
-->
<edges xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/edges_file.xsd">

    <!-- ── Main platoon route ── -->

    <!-- Approach: 400 m east, vehicles enter from here -->
    <edge id="e_approach" from="n_west"   to="n_int1"
          numLanes="1" speed="13.89" priority="3"/>

    <!-- Vertical segment: 300 m north, between the two intersections.
         NLOSv is maximum here: all vehicles aligned N-S, every intermediate
         vehicle blocks the TX→RX line-of-sight.
         IVD varies along this segment because vehicles enter at different
         speeds (some still decelerating from int1, some already at cruise,
         some braking for int2). -->
    <edge id="e_vertical" from="n_int1"   to="n_int2"
          numLanes="1" speed="13.89" priority="3"/>

    <!-- Exit: 500 m east, gives the platoon room to clear int2 -->
    <edge id="e_exit"     from="n_int2"   to="n_east"
          numLanes="1" speed="13.89" priority="3"/>

    <!-- ── Dummy arms (required for proper junction geometry) ── -->

    <!-- East arm of int1: vehicles never use this -->
    <edge id="e_int1_e"   from="n_int1"   to="n_int1_e"
          numLanes="1" speed="13.89" priority="1"/>

    <!-- North arm of int2: vehicles never use this -->
    <edge id="e_int2_n"   from="n_int2"   to="n_int2_n"
          numLanes="1" speed="13.89" priority="1"/>

</edges>
