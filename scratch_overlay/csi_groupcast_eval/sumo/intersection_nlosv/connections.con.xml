<?xml version="1.0" encoding="UTF-8"?>
<!--
  intersection_nlosv — connection definitions
  =============================================
  Only the platoon turn movements are defined.
  netconvert will generate connections for the dummy arms automatically;
  the platoon vehicles follow their route and will only use these two.

  int1: e_approach → e_vertical  (LEFT  turn: east  → north)
  int2: e_vertical → e_exit      (RIGHT turn: north → east)
-->
<connections xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/connections_file.xsd">

    <!-- Left turn at int1 (east → north) -->
    <connection from="e_approach" to="e_vertical" fromLane="0" toLane="0"/>

    <!-- Right turn at int2 (north → east) -->
    <connection from="e_vertical" to="e_exit"     fromLane="0" toLane="0"/>

</connections>
