<?xml version="1.0" encoding="UTF-8"?>
<!--
  intersection_nlosv — vehicle / route definitions
  ==================================================
  9 vehicles: 1 transmitter (tx_0) + 8 receivers (rx_1..rx_8).
  All depart at t=0 on e_approach with 25 m front-to-front spacing.

  Initial IVD = 25 m at 50 km/h = 1.80 s time-headway.
  At 90° turns (junction radius=10 m) vehicles slow to ≈4.5 m/s (16 km/h):
    corner IVD ≈ 25 × (4.5/13.89) ≈ 8 m  → 3× compression vs straight.

  NLOSv geometry:
    - On e_vertical (300 m north segment) every vehicle is at x≈0, y∈[0,300].
      The TX→RX line between any two vehicles passes through every intermediate
      vehicle → maximum NLOSv activation.
    - At the turns the geometry creates partial LOS/NLOSv transitions as
      vehicles exit/enter the straight segment at different times.

  Platoon phase snapshot (approx. t≈42 s, when tx_0 reaches int2):
    tx_0  : at int2 (0,300), turning right — slow ≈4 m/s
    rx_1  : ≈265 m into e_vertical (0,265), braking
    rx_2  : ≈240 m into e_vertical (0,240), braking
    rx_3  : ≈215 m into e_vertical (0,215), cruising
    rx_4  : ≈190 m into e_vertical (0,190), cruising
    rx_5  : ≈165 m into e_vertical (0,165), cruising
    rx_6  : ≈140 m into e_vertical (0,140), cruising
    rx_7  : ≈115 m into e_vertical (0,115), accelerating from int1
    rx_8  : ≈ 90 m into e_vertical (0, 90), just exited int1 — slow ≈6 m/s
  → IVD tx_0→rx_1 enlarged (tx_0 decelerating), IVD rx_7→rx_8 still large
    (rx_8 exiting turn), mid-platoon IVDs nominally 25 m at cruise.

  blockerIds for csi_groupcast_eval:
    "tx_0,rx_1,rx_2,rx_3,rx_4,rx_5,rx_6,rx_7,rx_8"
  (all 9 vehicles are both communicating UEs and NLOSv blockers)
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <vType id="car"
           vClass="passenger"
           length="4.5"
           width="2.0"
           maxSpeed="13.89"
           accel="2.5"
           decel="4.5"
           tau="0.5"
           minGap="2.5"
           sigma="0.0"
           speedFactor="1.0"/>

    <!-- Platoon route: approach → left turn → vertical → right turn → exit -->
    <route id="platoon_route" edges="e_approach e_vertical e_exit"/>

    <!--
      departPos: distance from the start of e_approach (400 m road).
      tx_0 is at the front of the platoon (nearest to int1).
      25 m front-to-front spacing → rx_8 starts 200 m behind tx_0.
    -->
    <vehicle id="tx_0" type="car" route="platoon_route"
             depart="0" departPos="375" departSpeed="13.89"
             color="0,1,0">
        <param key="role"     value="tx"/>
        <param key="group_id" value="group_0"/>
    </vehicle>

    <vehicle id="rx_1" type="car" route="platoon_route"
             depart="0" departPos="350" departSpeed="13.89"
             color="0,0.5,1">
        <param key="role"     value="rx"/>
        <param key="group_id" value="group_0"/>
        <param key="rx_index" value="1"/>
    </vehicle>

    <vehicle id="rx_2" type="car" route="platoon_route"
             depart="0" departPos="325" departSpeed="13.89"
             color="0,0.5,1">
        <param key="role"     value="rx"/>
        <param key="group_id" value="group_0"/>
        <param key="rx_index" value="2"/>
    </vehicle>

    <vehicle id="rx_3" type="car" route="platoon_route"
             depart="0" departPos="300" departSpeed="13.89"
             color="0,0.5,1">
        <param key="role"     value="rx"/>
        <param key="group_id" value="group_0"/>
        <param key="rx_index" value="3"/>
    </vehicle>

    <vehicle id="rx_4" type="car" route="platoon_route"
             depart="0" departPos="275" departSpeed="13.89"
             color="0,0.5,1">
        <param key="role"     value="rx"/>
        <param key="group_id" value="group_0"/>
        <param key="rx_index" value="4"/>
    </vehicle>

    <vehicle id="rx_5" type="car" route="platoon_route"
             depart="0" departPos="250" departSpeed="13.89"
             color="0,0.5,1">
        <param key="role"     value="rx"/>
        <param key="group_id" value="group_0"/>
        <param key="rx_index" value="5"/>
    </vehicle>

    <vehicle id="rx_6" type="car" route="platoon_route"
             depart="0" departPos="225" departSpeed="13.89"
             color="0,0.5,1">
        <param key="role"     value="rx"/>
        <param key="group_id" value="group_0"/>
        <param key="rx_index" value="6"/>
    </vehicle>

    <vehicle id="rx_7" type="car" route="platoon_route"
             depart="0" departPos="200" departSpeed="13.89"
             color="0,0.5,1">
        <param key="role"     value="rx"/>
        <param key="group_id" value="group_0"/>
        <param key="rx_index" value="7"/>
    </vehicle>

    <vehicle id="rx_8" type="car" route="platoon_route"
             depart="0" departPos="175" departSpeed="13.89"
             color="0,0.5,1">
        <param key="role"     value="rx"/>
        <param key="group_id" value="group_0"/>
        <param key="rx_index" value="8"/>
    </vehicle>

</routes>
